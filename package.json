{
  "name": "automation",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @automation/db generate",
    "db:migrate": "pnpm --filter @automation/db migrate",
    "db:deploy": "pnpm --filter @automation/db migrate:deploy",
    "db:seed": "pnpm --filter @automation/db seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "globals": "^17.13.0",
    "prettier": "^3.6.2",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "5.0.5"
  }
}
