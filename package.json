{
  "name": "automation",
  "private": true,
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "brew services start redis 2>/dev/null; pkill -f 'next dev' 2>/dev/null; turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "ml:install": "python3 -m venv services/ml/.venv && services/ml/.venv/bin/pip install -r services/ml/requirements-dev.txt",
    "ml:train": "cd services/ml && .venv/bin/python -m app.train",
    "ml:dev": "cd services/ml && ML_ALLOW_NO_AUTH=${ML_ALLOW_NO_AUTH:-1} .venv/bin/python -m app",
    "ml:test": "cd services/ml && .venv/bin/python -m pytest -q",
    "db:status": "prisma migrate status",
    "db:validate": "prisma validate",
    "docker:init": "node scripts/docker-init.mjs",
    "docker:up": "npm run docker:init && docker compose --env-file .env.docker -f docker/docker-compose.yml up -d --build",
    "docker:down": "docker compose --env-file .env.docker -f docker/docker-compose.yml down",
    "docker:logs": "docker compose --env-file .env.docker -f docker/docker-compose.yml logs -f --tail=100",
    "docker:ps": "docker compose --env-file .env.docker -f docker/docker-compose.yml ps",
    "docker:seed": "docker compose --env-file .env.docker -f docker/docker-compose.yml --profile seed run --rm seed",
    "docker:reset": "docker compose --env-file .env.docker -f docker/docker-compose.yml down -v",
    "docker:dev": "docker compose -f docker/docker-compose.dev.yml up -d",
    "docker:dev:ml": "docker compose -f docker/docker-compose.dev.yml --profile ml up -d --build",
    "docker:dev:down": "docker compose -f docker/docker-compose.dev.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "globals": "^17.13.0",
    "prettier": "^3.6.2",
    "prisma": "7.10.1",
    "tsx": "^4.20.0",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "5.0.5"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  }
}