// Multi-tenant schema. Tables owned by a client carry client_id (indexed).
// Access them through the scoped helpers in src/scope.ts, never the raw client.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum ClientStatus {
  active
  paused
  archived
}

enum MembershipRole {
  admin
  member
  viewer
}

enum WebsiteStatus {
  active
  inactive
}

enum JobRunStatus {
  running
  success
  failed
}

enum IntegrationProvider {
  google
}

enum IntegrationStatus {
  active
  needs_reauth
  disconnected
}

// ---- Users and auth (managed by Better Auth) -------------------------------

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  // Platform admin: sees and manages every client.
  isAdmin       Boolean  @default(false) @map("is_admin")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sessions    Session[]
  accounts    Account[]
  memberships Membership[]
  auditLogs   AuditLog[]
  connections IntegrationConnection[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ---- Tenants -----------------------------------------------------------------

model Client {
  id                 String         @id @default(uuid())
  name               String
  slug               String         @unique
  status             ClientStatus @default(active)
  reportEmail        String?        @map("report_email")
  reportIntervalDays Int            @default(15) @map("report_interval_days")
  // Per-client behavior lives in data: brand voice, schedule, etc.
  settings           Json           @default("{}")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  websites     Website[]
  memberships  Membership[]
  jobRuns      JobRun[]
  auditLogs    AuditLog[]
  integrations IntegrationConnection[]

  @@index([status])
  @@map("clients")
}

model Membership {
  id         String         @id @default(uuid())
  userId     String         @map("user_id")
  clientId String         @map("client_id")
  role       MembershipRole
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([clientId])
  @@map("memberships")
}

model Website {
  id         String        @id @default(uuid())
  clientId String        @map("client_id")
  domain     String
  isPrimary  Boolean       @default(false) @map("is_primary")
  status     WebsiteStatus @default(active)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, domain])
  @@index([clientId])
  @@map("websites")
}

model JobRun {
  id         String       @id @default(uuid())
  jobName    String       @map("job_name")
  // Null only for system-level jobs that are not client-specific.
  clientId String?      @map("client_id")
  status     JobRunStatus @default(running)
  startedAt  DateTime     @default(now()) @map("started_at")
  finishedAt DateTime?    @map("finished_at")
  error      String?
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, startedAt(sort: Desc)])
  @@index([jobName, startedAt(sort: Desc)])
  @@map("job_runs")
}

// Append-only: application code only ever creates rows (no updated_at on purpose).
model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?  @map("actor_user_id")
  clientId  String?  @map("client_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  before      Json?
  after       Json?
  createdAt   DateTime @default(now()) @map("created_at")

  actor    User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt(sort: Desc)])
  @@index([actorUserId])
  @@map("audit_log")
}

// One connection per client per provider. The refresh token is stored encrypted
// (AES-256-GCM, see @automation/integrations) and is never returned to the browser.
model IntegrationConnection {
  id                    String              @id @default(uuid())
  clientId            String              @map("client_id")
  provider              IntegrationProvider
  status                IntegrationStatus   @default(active)
  accountEmail          String?             @map("account_email")
  scopes                String[]
  encryptedRefreshToken String              @map("encrypted_refresh_token")
  gscSiteUrl            String?             @map("gsc_site_url")
  ga4PropertyId         String?             @map("ga4_property_id")
  connectedById         String?             @map("connected_by_id")
  lastSyncedAt          DateTime?           @map("last_synced_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  connectedBy User?    @relation(fields: [connectedById], references: [id], onDelete: SetNull)

  @@unique([clientId, provider])
  @@map("integration_connections")
}
