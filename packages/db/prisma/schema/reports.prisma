// ---- Reporting -------------------------------------------------------------------------------

enum ReportStatus {
  draft
  generating
  ready
  approved
  delivered
  failed
  archived
}

enum ReportSectionKind {
  summary
  kpi
  chart
  table
  text
}

enum DeliveryChannel {
  email
  download
}

enum DeliveryStatus {
  pending
  sent
  delivered
  bounced
  failed
  cancelled
}

// Agency-level layout reused across that agency's clients.
model ReportTemplate {
  id          String    @id @default(uuid())
  agencyId    String    @map("agency_id")
  slug        String
  name        String
  description String?
  version     Int       @default(1)
  // Ordered section definitions: [{ key, kind, title, metrics: [...] }]
  layout      Json      @default("[]") @db.JsonB
  isDefault   Boolean   @default(false) @map("is_default")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)

  agency  Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  reports Report[]

  @@unique([agencyId, slug])
  @@unique([id, agencyId])
  @@map("report_templates")
}

model Report {
  id              String       @id @default(uuid())
  agencyId        String       @map("agency_id")
  clientId        String       @map("client_id")
  templateId      String?      @map("template_id")
  title           String
  periodStart     DateTime     @map("period_start") @db.Date
  periodEnd       DateTime     @map("period_end") @db.Date
  // Regenerating a period creates revision n+1; earlier revisions stay for audit.
  revision        Int          @default(1)
  templateVersion Int?         @map("template_version")
  status          ReportStatus @default(draft)
  fileStorageKey  String?      @unique @map("file_storage_key")
  fileSha256      String?      @map("file_sha256") @db.Char(64)
  config          Json         @default("{}") @db.JsonB
  createdById     String?      @map("created_by_id")
  approvedById    String?      @map("approved_by_id")
  generatedAt     DateTime?    @map("generated_at") @db.Timestamptz(3)
  approvedAt      DateTime?    @map("approved_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  client     Client          @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)
  // The template must belong to the same agency as the client.
  template   ReportTemplate? @relation(fields: [templateId, agencyId], references: [id, agencyId], onDelete: Restrict)
  createdBy  User?           @relation("ReportCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User?           @relation("ReportApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  // CHECK (period_end >= period_start) is added in the migration.
  reportSections      ReportSection[]
  reportDataSnapshots ReportDataSnapshot[]
  reportDeliveries    ReportDelivery[]

  @@unique([clientId, templateId, periodStart, periodEnd, revision])
  @@unique([id, clientId])
  @@index([clientId, status, periodEnd(sort: Desc)])
  @@map("reports")
}

model ReportSection {
  id          String            @id @default(uuid())
  agencyId    String            @map("agency_id")
  clientId    String            @map("client_id")
  reportId    String            @map("report_id")
  key         String
  position    Int
  kind        ReportSectionKind
  title       String
  content     Json              @default("{}") @db.JsonB
  aiGenerated Boolean           @default(false) @map("ai_generated")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  client              Client               @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)
  report              Report               @relation(fields: [reportId, clientId], references: [id, clientId], onDelete: Cascade)
  reportDataSnapshots ReportDataSnapshot[]

  @@unique([reportId, key])
  @@unique([reportId, position])
  @@unique([id, clientId])
  @@map("report_sections")
}

// The frozen numbers a report was built from, so it can be reproduced exactly even after
// later syncs revise the underlying metrics.
model ReportDataSnapshot {
  id                String   @id @default(uuid())
  agencyId          String   @map("agency_id")
  clientId          String   @map("client_id")
  reportId          String   @map("report_id")
  sectionId         String?  @map("section_id")
  analyticsSourceId String?  @map("analytics_source_id")
  key               String
  rangeStart        DateTime @map("range_start") @db.Date
  rangeEnd          DateTime @map("range_end") @db.Date
  data              Json     @db.JsonB
  dataHash          String   @map("data_hash") @db.Char(64)
  capturedAt        DateTime @default(now()) @map("captured_at") @db.Timestamptz(3)

  client          Client           @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)
  report          Report           @relation(fields: [reportId, clientId], references: [id, clientId], onDelete: Cascade)
  section         ReportSection?   @relation(fields: [sectionId, clientId], references: [id, clientId], onDelete: Restrict)
  analyticsSource AnalyticsSource? @relation(fields: [analyticsSourceId, clientId], references: [id, clientId], onDelete: Restrict)

  @@unique([reportId, key])
  @@index([clientId])
  @@map("report_data_snapshots")
}

model ReportDelivery {
  id                String          @id @default(uuid())
  agencyId          String          @map("agency_id")
  clientId          String          @map("client_id")
  reportId          String          @map("report_id")
  channel           DeliveryChannel
  recipient         String
  status            DeliveryStatus  @default(pending)
  providerMessageId String?         @map("provider_message_id")
  attempts          Int             @default(0)
  error             String?
  sentAt            DateTime?       @map("sent_at") @db.Timestamptz(3)
  deliveredAt       DateTime?       @map("delivered_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  client Client @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)
  report Report @relation(fields: [reportId, clientId], references: [id, clientId], onDelete: Cascade)

  // The same report is never sent twice to the same recipient on the same channel.
  @@unique([reportId, channel, recipient])
  @@index([clientId, status])
  @@map("report_deliveries")
}
