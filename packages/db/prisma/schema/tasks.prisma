// ---- Tasks, collaboration and time tracking -------------------------------------------------

// Backlog -> Assigned -> In progress -> Ready for review -> Approved -> Completed, plus
// Changes requested (back from review), Blocked and Cancelled. The allowed moves are in
// src/services/task-rules.ts.
enum TaskStatus {
  backlog
  assigned
  in_progress
  ready_for_review
  changes_requested
  blocked
  approved
  completed
  cancelled
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum TaskType {
  general
  seo_fix
  content
  social
  reporting
}

enum TaskSource {
  manual
  seo_issue
  automation
  ai
}

enum TaskEventType {
  created
  updated
  status_changed
  assigned
  unassigned
  priority_changed
  due_date_changed
  comment_added
  attachment_added
  dependency_added
  dependency_removed
  archived
  reassigned
  evidence_submitted
  time_logged
  linked
}

model Task {
  id                 String       @id @default(uuid())
  agencyId           String       @map("agency_id")
  clientId           String       @map("client_id")
  projectId          String?      @map("project_id")
  parentTaskId       String?      @map("parent_task_id")
  title              String
  description        String?
  // What "done" means, one line per criterion; the reviewer checks the work against it.
  acceptanceCriteria String?      @map("acceptance_criteria")
  type               TaskType     @default(general)
  source             TaskSource   @default(manual)
  status             TaskStatus   @default(backlog)
  priority           TaskPriority @default(medium)
  assigneeId         String?      @map("assignee_id")
  reporterId         String?      @map("reporter_id")
  labels             String[]
  estimateMinutes    Int?         @map("estimate_minutes")
  // Manual ordering inside a board column.
  sortOrder          Decimal      @default(0) @map("sort_order") @db.Decimal(20, 10)
  // Proof of the finished work, submitted with "Ready for review".
  evidenceNote       String?      @map("evidence_note")
  evidenceLinks      String[]     @default([]) @map("evidence_links")
  reviewRequestedAt  DateTime?    @map("review_requested_at") @db.Timestamptz(3)
  // Optional link to the content this task is about (the SEO issue link lives on seo_issues.task_id).
  contentItemId      String?      @map("content_item_id")
  // End of the due day in the client's time zone.
  dueAt              DateTime?    @map("due_at") @db.Timestamptz(3)
  startedAt          DateTime?    @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime?    @map("completed_at") @db.Timestamptz(3)
  archivedAt         DateTime?    @map("archived_at") @db.Timestamptz(3)
  // True for development seed rows, so the UI can tell them apart from live provider data.
  isSample           Boolean      @default(false) @map("is_sample")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  client       Client           @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)
  project      Project?         @relation(fields: [projectId, clientId], references: [id, clientId], onDelete: Restrict)
  contentItem  ContentItem?     @relation(fields: [contentItemId, clientId], references: [id, clientId], onDelete: Restrict)
  parentTask   Task?            @relation("TaskSubtasks", fields: [parentTaskId, clientId], references: [id, clientId], onDelete: Restrict)
  // Eligibility (assignee has access to the client) is enforced by a trigger, see migration.
  assignee     User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter     User?            @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  seoIssues    SeoIssue[]
  subtasks     Task[]           @relation("TaskSubtasks")
  dependencies TaskDependency[] @relation("TaskBlockedBy")
  dependents   TaskDependency[] @relation("TaskBlocks")
  comments     TaskComment[]
  attachments  TaskAttachment[]
  events       TaskEvent[]
  timeEntries  TimeEntry[]

  @@unique([id, clientId])
  @@index([clientId, status, priority])
  @@index([clientId, assigneeId, status])
  @@index([clientId, projectId])
  @@index([clientId, dueAt])
  @@index([contentItemId])
  @@index([parentTaskId])
  @@map("tasks")
}

model TaskDependency {
  id              String   @id @default(uuid())
  agencyId        String   @map("agency_id")
  clientId        String   @map("client_id")
  taskId          String   @map("task_id")
  dependsOnTaskId String   @map("depends_on_task_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  client        Client @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)
  task          Task   @relation("TaskBlockedBy", fields: [taskId, clientId], references: [id, clientId], onDelete: Cascade)
  dependsOnTask Task   @relation("TaskBlocks", fields: [dependsOnTaskId, clientId], references: [id, clientId], onDelete: Cascade)

  // CHECK (task_id <> depends_on_task_id) is added in the migration.
  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
  @@index([clientId])
  @@map("task_dependencies")
}

model TaskComment {
  id        String    @id @default(uuid())
  agencyId  String    @map("agency_id")
  clientId  String    @map("client_id")
  taskId    String    @map("task_id")
  authorId  String?   @map("author_id")
  body      String
  editedAt  DateTime? @map("edited_at") @db.Timestamptz(3)
  // Soft delete keeps the conversation history intact.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  client Client @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)
  task   Task   @relation(fields: [taskId, clientId], references: [id, clientId], onDelete: Cascade)
  author User?  @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([clientId])
  @@map("task_comments")
}

model TaskAttachment {
  id           String    @id @default(uuid())
  agencyId     String    @map("agency_id")
  clientId     String    @map("client_id")
  taskId       String    @map("task_id")
  uploadedById String?   @map("uploaded_by_id")
  fileName     String    @map("file_name")
  mimeType     String    @map("mime_type")
  sizeBytes    BigInt    @map("size_bytes")
  // Object-storage key (never a public URL); access is by signed URL after an authorization check.
  storageKey   String    @unique @map("storage_key")
  sha256       String    @db.Char(64)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  client     Client @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)
  task       Task   @relation(fields: [taskId, clientId], references: [id, clientId], onDelete: Cascade)
  uploadedBy User?  @relation("TaskAttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([clientId])
  @@map("task_attachments")
}

// Append-only activity log of a task. Also records assignment history (from/to assignee), which is
// why there is no separate TaskAssignmentHistory table.
model TaskEvent {
  id        String        @id @default(uuid())
  agencyId  String        @map("agency_id")
  clientId  String        @map("client_id")
  taskId    String        @map("task_id")
  actorId   String?       @map("actor_id")
  type      TaskEventType
  fromValue Json?         @map("from_value") @db.JsonB
  toValue   Json?         @map("to_value") @db.JsonB
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  client Client @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)
  task   Task   @relation(fields: [taskId, clientId], references: [id, clientId], onDelete: Cascade)
  actor  User?  @relation("TaskEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt(sort: Desc)])
  @@index([clientId, type, createdAt(sort: Desc)])
  @@map("task_events")
}

model TimeEntry {
  id              String    @id @default(uuid())
  agencyId        String    @map("agency_id")
  clientId        String    @map("client_id")
  userId          String    @map("user_id")
  taskId          String?   @map("task_id")
  projectId       String?   @map("project_id")
  startedAt       DateTime  @map("started_at") @db.Timestamptz(3)
  // Null while a timer is running.
  endedAt         DateTime? @map("ended_at") @db.Timestamptz(3)
  durationSeconds Int       @default(0) @map("duration_seconds")
  billable        Boolean   @default(true)
  note            String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  client  Client   @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)
  user    User     @relation("TimeEntryUser", fields: [userId], references: [id], onDelete: Restrict)
  task    Task?    @relation(fields: [taskId, clientId], references: [id, clientId], onDelete: Restrict)
  project Project? @relation(fields: [projectId, clientId], references: [id, clientId], onDelete: Restrict)

  // CHECK (ended_at IS NULL OR ended_at >= started_at) is added in the migration.
  @@index([clientId, userId, startedAt(sort: Desc)])
  @@index([taskId])
  @@index([projectId])
  @@map("time_entries")
}
