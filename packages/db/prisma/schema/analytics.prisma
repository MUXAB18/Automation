// ---- Analytics: sources, metric catalogue and append-only metric snapshots -----------------

enum AnalyticsSourceKind {
  search_console
  ga4
  social_page
  other
}

enum MetricUnit {
  count
  percent
  ratio
  seconds
  currency
  position
}

enum MetricAggregation {
  sum
  avg
  min
  max
  last
}

enum MetricGranularity {
  day
  week
  month
}

// A specific property inside a connected account: a GSC site, a GA4 property, a social page.
model AnalyticsSource {
  id                   String              @id @default(uuid())
  agencyId             String              @map("agency_id")
  clientId             String              @map("client_id")
  integrationAccountId String              @map("integration_account_id")
  websiteId            String?             @map("website_id")
  kind                 AnalyticsSourceKind
  // Provider id: GSC site URL ("sc-domain:example.com"), GA4 property id, page URN.
  externalId           String              @map("external_id")
  displayName          String?             @map("display_name")
  timezone             String              @default("UTC")
  isActive             Boolean             @default(true) @map("is_active")
  lastSyncedAt         DateTime?           @map("last_synced_at") @db.Timestamptz(3)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  client              Client               @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)
  integrationAccount  IntegrationAccount   @relation(fields: [integrationAccountId, clientId], references: [id, clientId], onDelete: Cascade)
  website             Website?             @relation(fields: [websiteId, clientId], references: [id, clientId], onDelete: Restrict)
  metricSnapshots     MetricSnapshot[]
  syncRuns            SyncRun[]
  reportDataSnapshots ReportDataSnapshot[]

  @@unique([integrationAccountId, externalId])
  @@unique([id, clientId])
  @@index([clientId, kind, isActive])
  @@map("analytics_sources")
}

// Global catalogue of metrics (e.g. "gsc.clicks", "ga4.sessions"): one definition, many snapshots.
model MetricDefinition {
  id              String              @id @default(uuid())
  key             String              @unique
  name            String
  description     String?
  sourceKind      AnalyticsSourceKind @map("source_kind")
  unit            MetricUnit
  aggregation     MetricAggregation   @default(sum)
  isActive        Boolean             @default(true) @map("is_active")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  metricSnapshots MetricSnapshot[]

  @@map("metric_definitions")
}

// Append-only. A re-sync inserts new rows under a new sync run; "current" = latest captured_at per
// (source, metric, period, dimensions). Correct history (e.g. GSC data revisions) is never lost.
model MetricSnapshot {
  id                 String            @id @default(uuid())
  agencyId           String            @map("agency_id")
  clientId           String            @map("client_id")
  analyticsSourceId  String            @map("analytics_source_id")
  metricDefinitionId String            @map("metric_definition_id")
  syncRunId          String            @map("sync_run_id")
  granularity        MetricGranularity @default(day)
  periodStart        DateTime          @map("period_start") @db.Date
  // Canonical "key=value|key=value" form of `dimensions` (sorted), used for uniqueness. '' = none.
  dimensionKey       String            @default("") @map("dimension_key")
  dimensions         Json              @default("{}") @db.JsonB
  value              Decimal           @db.Decimal(24, 6)
  // False for provisional provider data that may still be revised.
  isFinal            Boolean           @default(true) @map("is_final")
  capturedAt         DateTime          @default(now()) @map("captured_at") @db.Timestamptz(3)

  client           Client           @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)
  analyticsSource  AnalyticsSource  @relation(fields: [analyticsSourceId, clientId], references: [id, clientId], onDelete: Cascade)
  metricDefinition MetricDefinition @relation(fields: [metricDefinitionId], references: [id], onDelete: Restrict)
  syncRun          SyncRun          @relation(fields: [syncRunId, clientId], references: [id, clientId], onDelete: Restrict)

  @@unique([syncRunId, analyticsSourceId, metricDefinitionId, granularity, periodStart, dimensionKey])
  @@index([clientId, analyticsSourceId, metricDefinitionId, periodStart(sort: Desc), capturedAt(sort: Desc)])
  @@index([metricDefinitionId])
  @@map("metric_snapshots")
}
