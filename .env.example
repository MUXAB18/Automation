# Core
DATABASE_URL=postgresql://user@localhost:5432/automation
TEST_DATABASE_URL=postgresql://user@localhost:5432/automation_test
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000

# Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Seed (dev only): initial platform admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin
# Development only: set to also create one sample user per role (all share this password)
SEED_DEV_USER_PASSWORD=

# Worker
HEARTBEAT_INTERVAL_MS=300000
# How often the worker looks for queued and due integration syncs (needs ENCRYPTION_KEY too).
SYNC_POLL_INTERVAL_MS=15000

# Later steps
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Outgoing email: "log" (dev: prints links to the server console) or "resend"
MAIL_TRANSPORT=log
EMAIL_API_KEY=
EMAIL_FROM="Agency <no-reply@yourdomain.com>"
# 32-byte key, base64 or hex; used to encrypt stored third-party tokens
ENCRYPTION_KEY=
# Optional: comma-separated retired keys, only used to decrypt during rotation
ENCRYPTION_KEY_PREVIOUS=

# Python keyword service (services/ml). Token must be 24+ characters.
ML_SERVICE_URL=http://127.0.0.1:8001
ML_SERVICE_TOKEN=

# GoHighLevel marketplace app (platform-wide). Set all three or none; without them GoHighLevel can only
# be connected as the development mock. GHL_REDIRECT_URI = <APP_URL>/api/integrations/gohighlevel/callback
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=
# Posting is unverified against a real account: keep 0 until tested in a sandbox location.
GHL_PUBLISHING_ENABLED=0
# Redirect URI for Google sign-in (Analytics / Search Console): <APP_URL>/api/integrations/google/callback
GOOGLE_REDIRECT_URI=

# AI content generation. "mock" needs no key: deterministic placeholder output for local development.
AI_PROVIDER=mock
# AI_MODEL=
# AI_API_KEY=
# AI_BASE_URL=
# AI_DEFAULT_MONTHLY_REQUESTS=200
# AI_DEFAULT_MONTHLY_COST_USD=0
# AI_PER_USER_HOURLY=30
# Estimates only; there is no built-in price list. Example: {"my-model":{"inputPerMTok":3,"outputPerMTok":15}}
# AI_PRICING_JSON=

# Report delivery runs in the worker. MAIL_TRANSPORT=log only prints (development); use resend in production.
REPORT_POLL_INTERVAL_MS=60000

# Operations (see docs/production.md and docs/operations.md)
# JSON log verbosity: debug | info | warn | error
LOG_LEVEL=info
# Worker health endpoint (GET /health) for container probes; 0 disables
WORKER_HEALTH_PORT=8081
