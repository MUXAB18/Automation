// ---- Clients (the businesses an agency manages), projects and websites ---------------------

enum ClientStatus {
  active
  paused
  archived
}

enum ProjectKind {
  seo
  social
  content
  general
}

enum ProjectStatus {
  active
  paused
  completed
  archived
}

enum ProjectRole {
  lead
  contributor
  viewer
}

enum WebsiteStatus {
  active
  inactive
}

// A business managed by an agency. Root of all client-owned data.
model Client {
  id                 String       @id @default(uuid())
  agencyId           String       @map("agency_id")
  name               String
  slug               String
  status             ClientStatus @default(active)
  timezone           String       @default("UTC")
  locale             String       @default("en-CA")
  reportEmail        String?      @map("report_email")
  reportIntervalDays Int          @default(15) @map("report_interval_days")
  industry           String?
  // Free text: what the client wants to achieve (shown to the whole team).
  goals              String?
  // Places the client wants to be found in, e.g. "Ottawa, ON", "Canada".
  targetLocations    String[]     @default([]) @map("target_locations")
  // The agency person responsible for this client. Must have access to the client (trigger).
  accountOwnerId     String?      @map("account_owner_id")
  // Per-client behavior lives in data: brand voice, schedule, etc.
  settings           Json         @default("{}") @db.JsonB
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  // Clients are archived, not deleted; hard delete is an explicit purge (see docs).
  archivedAt         DateTime?    @map("archived_at") @db.Timestamptz(3)

  agency                 Agency                  @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  accountOwner           User?                   @relation("ClientAccountOwner", fields: [accountOwnerId], references: [id], onDelete: SetNull)
  analyticsSources       AnalyticsSource[]
  metricSnapshots        MetricSnapshot[]
  automationRules        AutomationRule[]
  automationFindings     AutomationFinding[]
  automationRuns         AutomationRun[]
  automationStepRuns     AutomationStepRun[]
  idempotencyKeys        IdempotencyKey[]
  clientMemberships      ClientMembership[]
  projects               Project[]
  projectMemberships     ProjectMembership[]
  websites               Website[]
  brandGuidelines        BrandGuideline[]
  contentCalendars       ContentCalendar[]
  contentItems           ContentItem[]
  contentVersions        ContentVersion[]
  contentAssets          ContentAsset[]
  aiJobs                 AiJob[]
  aiUsageRecords         AiUsageRecord[]
  aiApprovedSources      AiApprovedSource[]
  reportDeliveryAttempts ReportDeliveryAttempt[]
  reportSchedules        ReportSchedule[]
  aiLimits               AiLimit[]
  contentComments        ContentComment[]
  contentStatusEvents    ContentStatusEvent[]
  manualPublications     ManualPublication[]
  integrationAccounts    IntegrationAccount[]
  syncRuns               SyncRun[]
  crmContacts            CrmContact[]
  crmPipelines           CrmPipeline[]
  crmOpportunities       CrmOpportunity[]
  crmConversations       CrmConversation[]
  crmAutomations         CrmAutomation[]
  providerSocialAccounts ProviderSocialAccount[]
  providerSocialPosts    ProviderSocialPost[]
  providerSocialStats    ProviderSocialStat[]
  providerSeoProjects    ProviderSeoProject[]
  syncErrors             SyncError[]
  webhookEvents          WebhookEvent[]
  notifications          Notification[]
  jobRuns                JobRun[]
  contentApprovals       ContentApproval[]
  approvalEvents         ApprovalEvent[]
  publishingJobs         PublishingJob[]
  publishedPosts         PublishedPost[]
  postMetricSnapshots    PostMetricSnapshot[]
  reports                Report[]
  reportSections         ReportSection[]
  reportDataSnapshots    ReportDataSnapshot[]
  reportDeliveries       ReportDelivery[]
  seoProjects            SeoProject[]
  keywords               Keyword[]
  keywordRankSnapshots   KeywordRankSnapshot[]
  siteAudits             SiteAudit[]
  seoIssues              SeoIssue[]
  seoIssueHistories      SeoIssueHistory[]
  competitors            Competitor[]
  backlinkSnapshots      BacklinkSnapshot[]
  websitePages           WebsitePage[]
  tasks                  Task[]
  invitations            Invitation[]
  taskDependencies       TaskDependency[]
  taskComments           TaskComment[]
  taskAttachments        TaskAttachment[]
  taskEvents             TaskEvent[]
  timeEntries            TimeEntry[]

  @@unique([agencyId, slug])
  // Target of the (client_id, agency_id) composite FK present on every client-owned table.
  @@unique([id, agencyId])
  @@index([agencyId, status])
  @@index([accountOwnerId])
  @@map("clients")
}

// Access of one user to one client. The user must already be a member of the client's agency
// (composite FK). Roles are attached through client_membership_roles (a user can hold several).
model ClientMembership {
  id        String           @id @default(uuid())
  agencyId  String           @map("agency_id")
  clientId  String           @map("client_id")
  userId    String           @map("user_id")
  status    MembershipStatus @default(active)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  client             Client                 @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)
  agencyMembership   AgencyMembership       @relation(fields: [agencyId, userId], references: [agencyId, userId], onDelete: Cascade)
  projectMemberships ProjectMembership[]
  roles              ClientMembershipRole[]

  @@unique([userId, clientId])
  @@unique([id, agencyId])
  @@index([clientId])
  @@map("client_memberships")
}

// A unit of work for a client (an SEO programme, a social calendar, ...).
model Project {
  id          String        @id @default(uuid())
  agencyId    String        @map("agency_id")
  clientId    String        @map("client_id")
  name        String
  slug        String
  kind        ProjectKind   @default(general)
  status      ProjectStatus @default(active)
  description String?
  goals       String?
  // Per-project requirements, e.g. { social: { channels, postsPerWeek, requirements } }. Validated in code.
  settings    Json          @default("{}") @db.JsonB
  startsOn    DateTime?     @map("starts_on") @db.Date
  endsOn      DateTime?     @map("ends_on") @db.Date
  createdById String?       @map("created_by_id")
  // True for development seed rows, so the UI can tell them apart from live provider data.
  isSample    Boolean       @default(false) @map("is_sample")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt  DateTime?     @map("archived_at") @db.Timestamptz(3)

  client             Client              @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)
  createdBy          User?               @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  projectMemberships ProjectMembership[]
  contentCalendars   ContentCalendar[]
  contentItems       ContentItem[]
  aiJobs             AiJob[]
  aiApprovedSources  AiApprovedSource[]
  seoProject         SeoProject?
  tasks              Task[]
  automationRules    AutomationRule[]
  timeEntries        TimeEntry[]

  @@unique([clientId, slug])
  @@unique([id, clientId])
  @@index([clientId, status])
  @@map("projects")
}

model ProjectMembership {
  id        String      @id @default(uuid())
  agencyId  String      @map("agency_id")
  clientId  String      @map("client_id")
  projectId String      @map("project_id")
  userId    String      @map("user_id")
  role      ProjectRole @default(contributor)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  client           Client           @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)
  project          Project          @relation(fields: [projectId, clientId], references: [id, clientId], onDelete: Cascade)
  // Only people who have access to the client can join one of its projects.
  clientMembership ClientMembership @relation(fields: [userId, clientId], references: [userId, clientId], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([clientId])
  @@index([userId])
  @@map("project_memberships")
}

// A site a client owns. SEO work, pages and analytics hang off it.
model Website {
  id        String        @id @default(uuid())
  agencyId  String        @map("agency_id")
  clientId  String        @map("client_id")
  domain    String
  isPrimary Boolean       @default(false) @map("is_primary")
  status    WebsiteStatus @default(active)
  cmsType   String?       @map("cms_type")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  client           Client            @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)
  analyticsSources AnalyticsSource[]
  seoProjects      SeoProject[]
  websitePages     WebsitePage[]

  @@unique([clientId, domain])
  @@unique([id, clientId])
  @@index([clientId])
  @@map("websites")
}
