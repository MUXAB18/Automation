// ---- Reporting -------------------------------------------------------------------------------

enum ReportStatus {
  draft
  generating
  ready
  approved
  delivered
  failed
  archived
}

enum ReportSectionKind {
  summary
  kpi
  chart
  table
  text
}

enum DeliveryChannel {
  email
  download
}

enum DeliveryStatus {
  pending
  // A worker has claimed it and may be talking to the mail provider.
  sending
  // The provider could not confirm the outcome: a person checks before it is sent again.
  needs_review
  sent
  delivered
  bounced
  failed
  cancelled
}

// Agency-level layout reused across that agency's clients.
model ReportTemplate {
  id          String    @id @default(uuid())
  agencyId    String    @map("agency_id")
  slug        String
  name        String
  description String?
  version     Int       @default(1)
  // Ordered section definitions: [{ key, kind, title, metrics: [...] }]
  layout      Json      @default("[]") @db.JsonB
  isDefault   Boolean   @default(false) @map("is_default")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)

  agency  Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  reports Report[]

  @@unique([agencyId, slug])
  @@unique([id, agencyId])
  @@map("report_templates")
}

model Report {
  id              String       @id @default(uuid())
  agencyId        String       @map("agency_id")
  clientId        String       @map("client_id")
  templateId      String?      @map("template_id")
  title           String
  periodStart     DateTime     @map("period_start") @db.Date
  periodEnd       DateTime     @map("period_end") @db.Date
  // Regenerating a period creates revision n+1; earlier revisions stay for audit.
  revision        Int          @default(1)
  templateVersion Int?         @map("template_version")
  status          ReportStatus @default(draft)
  fileStorageKey  String?      @unique @map("file_storage_key")
  fileSha256      String?      @map("file_sha256") @db.Char(64)
  config          Json         @default("{}") @db.JsonB
  // "scheduled" (created by the schedule) or "manual".
  source          String       @default("manual")
  // Why the generation failed, when status is failed.
  error           String?
  reviewNote      String?      @map("review_note")
  createdById     String?      @map("created_by_id")
  approvedById    String?      @map("approved_by_id")
  generatedAt     DateTime?    @map("generated_at") @db.Timestamptz(3)
  approvedAt      DateTime?    @map("approved_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  client     Client          @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)
  // The template must belong to the same agency as the client.
  template   ReportTemplate? @relation(fields: [templateId, agencyId], references: [id, agencyId], onDelete: Restrict)
  createdBy  User?           @relation("ReportCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User?           @relation("ReportApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  // CHECK (period_end >= period_start) is added in the migration.
  reportSections      ReportSection[]
  reportDataSnapshots ReportDataSnapshot[]
  reportDeliveries    ReportDelivery[]

  @@unique([clientId, templateId, periodStart, periodEnd, revision])
  @@unique([id, clientId])
  @@index([clientId, status, periodEnd(sort: Desc)])
  @@map("reports")
}

model ReportSection {
  id          String            @id @default(uuid())
  agencyId    String            @map("agency_id")
  clientId    String            @map("client_id")
  reportId    String            @map("report_id")
  key         String
  position    Int
  kind        ReportSectionKind
  title       String
  content     Json              @default("{}") @db.JsonB
  aiGenerated Boolean           @default(false) @map("ai_generated")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  client              Client               @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)
  report              Report               @relation(fields: [reportId, clientId], references: [id, clientId], onDelete: Cascade)
  reportDataSnapshots ReportDataSnapshot[]

  @@unique([reportId, key])
  @@unique([reportId, position])
  @@unique([id, clientId])
  @@map("report_sections")
}

// The frozen numbers a report was built from, so it can be reproduced exactly even after
// later syncs revise the underlying metrics.
model ReportDataSnapshot {
  id                String   @id @default(uuid())
  agencyId          String   @map("agency_id")
  clientId          String   @map("client_id")
  reportId          String   @map("report_id")
  sectionId         String?  @map("section_id")
  analyticsSourceId String?  @map("analytics_source_id")
  key               String
  rangeStart        DateTime @map("range_start") @db.Date
  rangeEnd          DateTime @map("range_end") @db.Date
  data              Json     @db.JsonB
  dataHash          String   @map("data_hash") @db.Char(64)
  capturedAt        DateTime @default(now()) @map("captured_at") @db.Timestamptz(3)

  client          Client           @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)
  report          Report           @relation(fields: [reportId, clientId], references: [id, clientId], onDelete: Cascade)
  section         ReportSection?   @relation(fields: [sectionId, clientId], references: [id, clientId], onDelete: Restrict)
  analyticsSource AnalyticsSource? @relation(fields: [analyticsSourceId, clientId], references: [id, clientId], onDelete: Restrict)

  @@unique([reportId, key])
  @@index([clientId])
  @@map("report_data_snapshots")
}

model ReportDelivery {
  id                String          @id @default(uuid())
  agencyId          String          @map("agency_id")
  clientId          String          @map("client_id")
  reportId          String          @map("report_id")
  channel           DeliveryChannel
  recipient         String
  status            DeliveryStatus  @default(pending)
  providerMessageId String?         @map("provider_message_id")
  attempts          Int             @default(0)
  // How many times a person asked for it to be sent again.
  resendCount       Int             @default(0) @map("resend_count")
  error             String?
  nextAttemptAt     DateTime?       @map("next_attempt_at") @db.Timestamptz(3)
  // Stamped just before the mail provider is called. On a delivery that is still "sending" it means the outcome is unknown.
  requestSentAt     DateTime?       @map("request_sent_at") @db.Timestamptz(3)
  startedAt         DateTime?       @map("started_at") @db.Timestamptz(3)
  sentAt            DateTime?       @map("sent_at") @db.Timestamptz(3)
  deliveredAt       DateTime?       @map("delivered_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  client                 Client                  @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)
  report                 Report                  @relation(fields: [reportId, clientId], references: [id, clientId], onDelete: Cascade)
  reportDeliveryAttempts ReportDeliveryAttempt[]

  // The same report is never sent twice to the same recipient on the same channel.
  @@unique([reportId, channel, recipient])
  @@unique([id, clientId])
  @@index([clientId, status])
  @@map("report_deliveries")
}

// Append-only history of every try of a delivery.
model ReportDeliveryAttempt {
  id                String         @id @default(uuid())
  agencyId          String         @map("agency_id")
  clientId          String         @map("client_id")
  deliveryId        String         @map("delivery_id")
  attemptNo         Int            @map("attempt_no")
  status            DeliveryStatus
  error             String?
  providerMessageId String?        @map("provider_message_id")
  triggeredById     String?        @map("triggered_by_id")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  client   Client         @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)
  delivery ReportDelivery @relation(fields: [deliveryId, clientId], references: [id, clientId], onDelete: Cascade)

  @@index([deliveryId, createdAt])
  @@map("report_delivery_attempts")
}

// One schedule per client: report period length, anchor, send time in the client's time zone and recipients.
model ReportSchedule {
  id                String    @id @default(uuid())
  agencyId          String    @map("agency_id")
  clientId          String    @map("client_id")
  templateId        String?   @map("template_id")
  enabled           Boolean   @default(false)
  intervalDays      Int       @default(15) @map("interval_days")
  // First day of the first period, as a calendar day in the client's time zone.
  anchorDate        DateTime  @map("anchor_date") @db.Date
  // Local hour (0-23, client time zone) at which a finished period is generated.
  sendHour          Int       @default(9) @map("send_hour")
  recipients        String[]
  // Send to the recipients automatically once the report has been approved internally.
  deliverOnApproval Boolean   @default(true) @map("deliver_on_approval")
  // UTC instant at which the next period is due, computed by the application in the client's time zone.
  nextRunAt         DateTime? @map("next_run_at") @db.Timestamptz(3)
  lastPeriodEnd     DateTime? @map("last_period_end") @db.Date
  updatedById       String?   @map("updated_by_id")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  client Client @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)

  @@unique([clientId])
  @@unique([id, clientId])
  @@index([enabled, nextRunAt])
  @@map("report_schedules")
}
