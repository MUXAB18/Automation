// ---- Content: brand guidelines, calendar, items, versions, assets, AI jobs ------------------

enum ContentType {
  social_post
  blog_post
  page_update
  email
  other
}

enum ContentChannel {
  website
  linkedin
  facebook
  instagram
  x
  google_business
  email
}

// Lifecycle: idea -> brief -> draft -> in_review (internal review) -> client_approval (if required) -> approved
// -> scheduled -> publishing -> published. Side states: rejected, changes_requested, failed (publishing failed), cancelled.
enum ContentStatus {
  idea
  brief
  draft
  in_review
  client_approval
  changes_requested
  rejected
  approved
  scheduled
  publishing
  published
  failed
  cancelled
  archived
}

enum ContentAuthorKind {
  human
  ai
}

enum AssetKind {
  image
  video
  document
  other
}

enum CalendarStatus {
  active
  archived
}

enum AiJobKind {
  generate_content
  rewrite
  summarize
  seo_analysis
  report_summary
  other
}

enum AiJobStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

enum AiReviewOutcome {
  accepted
  needs_work
  rejected
}

// Versioned voice/tone rules. A new version is a new row (history kept); one is flagged active.
model BrandGuideline {
  id          String    @id @default(uuid())
  agencyId    String    @map("agency_id")
  clientId    String    @map("client_id")
  name        String
  version     Int       @default(1)
  toneOfVoice String?   @map("tone_of_voice")
  audience    String?
  styleNotes  String?   @map("style_notes")
  dos         String[]
  donts       String[]
  bannedTerms String[]  @map("banned_terms")
  isActive    Boolean   @default(false) @map("is_active")
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  client       Client        @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)
  createdBy    User?         @relation("BrandGuidelineCreator", fields: [createdById], references: [id], onDelete: SetNull)
  contentItems ContentItem[]

  @@unique([clientId, name, version])
  @@unique([id, clientId])
  @@index([clientId, isActive])
  @@map("brand_guidelines")
}

model ContentCalendar {
  id        String         @id @default(uuid())
  agencyId  String         @map("agency_id")
  clientId  String         @map("client_id")
  projectId String?        @map("project_id")
  name      String
  timezone  String         @default("UTC")
  status    CalendarStatus @default(active)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  client       Client        @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId, clientId], references: [id, clientId], onDelete: Restrict)
  contentItems ContentItem[]

  @@unique([clientId, name])
  @@unique([id, clientId])
  @@map("content_calendars")
}

model ContentItem {
  id                     String         @id @default(uuid())
  agencyId               String         @map("agency_id")
  clientId               String         @map("client_id")
  calendarId             String?        @map("calendar_id")
  projectId              String?        @map("project_id")
  brandGuidelineId       String?        @map("brand_guideline_id")
  currentVersionId       String?        @map("current_version_id")
  title                  String
  type                   ContentType
  channel                ContentChannel
  status                 ContentStatus  @default(draft)
  // Publishing needs an approval (CLAUDE.md rule 6); this flag can only be relaxed by an admin policy.
  requiresApproval       Boolean        @default(true) @map("requires_approval")
  // The client must also approve after internal review (set per item, defaulted from the client's settings).
  requiresClientApproval Boolean        @default(false) @map("requires_client_approval")
  // Idea / brief text that comes before the first draft.
  brief                  String?
  scheduledFor           DateTime?      @map("scheduled_for") @db.Timestamptz(3)
  // The client time zone the schedule was entered in (scheduled_for itself is the UTC instant).
  scheduledTimezone      String?        @map("scheduled_timezone")
  publishedAt            DateTime?      @map("published_at") @db.Timestamptz(3)
  createdById            String?        @map("created_by_id")
  assignedToId           String?        @map("assigned_to_id")
  // True for development seed rows, so the UI can tell them apart from live provider data.
  isSample               Boolean        @default(false) @map("is_sample")
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt             DateTime?      @map("archived_at") @db.Timestamptz(3)

  client             Client               @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)
  calendar           ContentCalendar?     @relation(fields: [calendarId, clientId], references: [id, clientId], onDelete: Restrict)
  project            Project?             @relation(fields: [projectId, clientId], references: [id, clientId], onDelete: Restrict)
  brandGuideline     BrandGuideline?      @relation(fields: [brandGuidelineId, clientId], references: [id, clientId], onDelete: Restrict)
  currentVersion     ContentVersion?      @relation("CurrentVersion", fields: [currentVersionId, clientId], references: [id, clientId], onDelete: Restrict)
  createdBy          User?                @relation("ContentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo         User?                @relation("ContentAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  contentVersions    ContentVersion[]
  contentAssets      ContentAsset[]
  contentApprovals   ContentApproval[]
  publishingJobs     PublishingJob[]
  publishedPosts     PublishedPost[]
  tasks              Task[]
  contentComments    ContentComment[]
  statusEvents       ContentStatusEvent[]
  manualPublications ManualPublication[]
  aiJobs             AiJob[]

  @@unique([id, clientId])
  @@index([clientId, status, scheduledFor])
  @@index([clientId, calendarId])
  @@map("content_items")
}

// Immutable once written: edits create the next version number.
model ContentVersion {
  id            String            @id @default(uuid())
  agencyId      String            @map("agency_id")
  clientId      String            @map("client_id")
  contentItemId String            @map("content_item_id")
  versionNo     Int               @map("version_no")
  title         String?
  body          String
  metadata      Json              @default("{}") @db.JsonB
  authorKind    ContentAuthorKind @default(human) @map("author_kind")
  createdById   String?           @map("created_by_id")
  aiJobId       String?           @map("ai_job_id")
  changeNote    String?           @map("change_note")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  client           Client            @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)
  contentItem      ContentItem       @relation(fields: [contentItemId, clientId], references: [id, clientId], onDelete: Cascade)
  createdBy        User?             @relation("ContentVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  aiJob            AiJob?            @relation(fields: [aiJobId, clientId], references: [id, clientId], onDelete: Restrict)
  currentVersions  ContentItem[]     @relation("CurrentVersion")
  contentApprovals ContentApproval[]
  publishingJobs   PublishingJob[]

  @@unique([contentItemId, versionNo])
  @@unique([id, clientId])
  // Lets approvals and publishing jobs prove that version, item and client all agree.
  @@unique([id, contentItemId, clientId])
  @@index([clientId])
  @@map("content_versions")
}

model ContentAsset {
  id            String    @id @default(uuid())
  agencyId      String    @map("agency_id")
  clientId      String    @map("client_id")
  contentItemId String?   @map("content_item_id")
  kind          AssetKind
  fileName      String    @map("file_name")
  mimeType      String    @map("mime_type")
  sizeBytes     BigInt    @map("size_bytes")
  width         Int?
  height        Int?
  altText       String?   @map("alt_text")
  storageKey    String    @unique @map("storage_key")
  sha256        String    @db.Char(64)
  createdById   String?   @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  client      Client       @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)
  contentItem ContentItem? @relation(fields: [contentItemId, clientId], references: [id, clientId], onDelete: Restrict)
  createdBy   User?        @relation("ContentAssetCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([id, clientId])
  @@index([clientId, contentItemId])
  @@map("content_assets")
}

// One AI request. Prompts/outputs are stored for audit; no API keys ever enter this table.
// `output` only ever holds output that passed Zod validation for the task. Nothing in it is a verified fact.
model AiJob {
  id                  String           @id @default(uuid())
  agencyId            String           @map("agency_id")
  clientId            String           @map("client_id")
  projectId           String?          @map("project_id")
  contentItemId       String?          @map("content_item_id")
  // Set on a regeneration: the job this one replaces (history is kept).
  parentJobId         String?          @map("parent_job_id")
  kind                AiJobKind
  // The generation task: content_brief, blog_draft, seo_titles, meta_descriptions, social_captions, hashtags, repurpose, seo_recommendations, report_summary.
  task                String           @default("other")
  status              AiJobStatus      @default(queued)
  provider            String
  model               String
  promptVersion       String?          @map("prompt_version")
  // What the person asked for (topic, keywords, tone...). Validated by the task's Zod schema.
  input               Json             @default("{}") @db.JsonB
  // Ids of everything the model was allowed to see: brand guideline, approved sources, supplied data.
  inputRefs           Json             @default("{}") @map("input_refs") @db.JsonB
  output              Json?            @db.JsonB
  error               String?
  attempt             Int              @default(1)
  nextAttemptAt       DateTime?        @map("next_attempt_at") @db.Timestamptz(3)
  idempotencyKey      String?          @map("idempotency_key")
  inputTokens         Int?             @map("input_tokens")
  outputTokens        Int?             @map("output_tokens")
  // Estimated, in micro-units of USD. Null when the model has no known price.
  estimatedCostMicros BigInt?          @map("estimated_cost_micros")
  reviewOutcome       AiReviewOutcome? @map("review_outcome")
  reviewerFeedback    String?          @map("reviewer_feedback")
  reviewedById        String?          @map("reviewed_by_id")
  reviewedAt          DateTime?        @map("reviewed_at") @db.Timestamptz(3)
  requestedById       String?          @map("requested_by_id")
  startedAt           DateTime?        @map("started_at") @db.Timestamptz(3)
  finishedAt          DateTime?        @map("finished_at") @db.Timestamptz(3)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  client          Client           @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)
  project         Project?         @relation(fields: [projectId, clientId], references: [id, clientId], onDelete: Restrict)
  contentItem     ContentItem?     @relation(fields: [contentItemId, clientId], references: [id, clientId], onDelete: Restrict)
  parentJob       AiJob?           @relation("AiJobRegeneration", fields: [parentJobId, clientId], references: [id, clientId], onDelete: Restrict)
  regenerations   AiJob[]          @relation("AiJobRegeneration")
  requestedBy     User?            @relation("AiJobRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedBy      User?            @relation("AiJobReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  contentVersions ContentVersion[]
  aiUsageRecords  AiUsageRecord[]

  @@unique([id, clientId])
  @@unique([clientId, idempotencyKey])
  @@index([clientId, status, createdAt(sort: Desc)])
  @@index([status, nextAttemptAt])
  @@map("ai_jobs")
}

// Material the agency has approved the model to use for a client (or one project): facts, product notes, quotes.
// The model sees nothing else about the client besides the active brand guideline and data the request names.
model AiApprovedSource {
  id           String    @id @default(uuid())
  agencyId     String    @map("agency_id")
  clientId     String    @map("client_id")
  projectId    String?   @map("project_id")
  title        String
  // Plain text the model may quote and rely on. Treated as data, never as instructions.
  body         String
  sourceUrl    String?   @map("source_url")
  approvedById String    @map("approved_by_id")
  approvedAt   DateTime  @default(now()) @map("approved_at") @db.Timestamptz(3)
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  client     Client   @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)
  project    Project? @relation(fields: [projectId, clientId], references: [id, clientId], onDelete: Restrict)
  approvedBy User     @relation("AiSourceApprover", fields: [approvedById], references: [id], onDelete: Restrict)

  @@unique([id, clientId])
  @@index([clientId, archivedAt])
  @@map("ai_approved_sources")
}

// Monthly allowance per client. No row = the server defaults (AI_DEFAULT_MONTHLY_REQUESTS / _COST_USD).
model AiLimit {
  id                String   @id @default(uuid())
  agencyId          String   @map("agency_id")
  clientId          String   @map("client_id")
  monthlyRequests   Int      @map("monthly_requests")
  // USD micro-units; 0 = no cost cap.
  monthlyCostMicros BigInt   @default(0) @map("monthly_cost_micros")
  updatedById       String?  @map("updated_by_id")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  client Client @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)

  @@unique([clientId])
  @@unique([id, clientId])
  @@map("ai_limits")
}

// Reviewer and author comments on a content item (optionally on one version). Append-only.
model ContentComment {
  id               String   @id @default(uuid())
  agencyId         String   @map("agency_id")
  clientId         String   @map("client_id")
  contentItemId    String   @map("content_item_id")
  contentVersionId String?  @map("content_version_id")
  authorId         String?  @map("author_id")
  body             String
  // True when the comment asks for changes (shown with the change request).
  isChangeRequest  Boolean  @default(false) @map("is_change_request")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  client      Client      @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)
  contentItem ContentItem @relation(fields: [contentItemId, clientId], references: [id, clientId], onDelete: Cascade)
  author      User?       @relation("ContentCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([contentItemId, createdAt])
  @@map("content_comments")
}

// Append-only history of every status change of a content item.
model ContentStatusEvent {
  id            String         @id @default(uuid())
  agencyId      String         @map("agency_id")
  clientId      String         @map("client_id")
  contentItemId String         @map("content_item_id")
  fromStatus    ContentStatus? @map("from_status")
  toStatus      ContentStatus  @map("to_status")
  actorId       String?        @map("actor_id")
  note          String?
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  client      Client      @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)
  contentItem ContentItem @relation(fields: [contentItemId, clientId], references: [id, clientId], onDelete: Cascade)
  actor       User?       @relation("ContentStatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([contentItemId, createdAt])
  @@map("content_status_events")
}

// Manual publishing fallback: someone posted it by hand (channel without a connected provider). One per version.
model ManualPublication {
  id               String   @id @default(uuid())
  agencyId         String   @map("agency_id")
  clientId         String   @map("client_id")
  contentItemId    String   @map("content_item_id")
  contentVersionId String   @map("content_version_id")
  publishedUrl     String?  @map("published_url")
  publishedAt      DateTime @map("published_at") @db.Timestamptz(3)
  note             String?
  markedById       String   @map("marked_by_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  client      Client      @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)
  contentItem ContentItem @relation(fields: [contentItemId, clientId], references: [id, clientId], onDelete: Cascade)
  markedBy    User        @relation("ManualPublicationMarker", fields: [markedById], references: [id], onDelete: Restrict)

  @@unique([contentVersionId])
  @@index([clientId, publishedAt(sort: Desc)])
  @@map("manual_publications")
}

// Append-only usage ledger for cost control and billing. Cost is in micro-units (1e-6) of `currency`.
model AiUsageRecord {
  id           String   @id @default(uuid())
  agencyId     String   @map("agency_id")
  clientId     String   @map("client_id")
  aiJobId      String   @map("ai_job_id")
  provider     String
  model        String
  inputTokens  Int      @map("input_tokens")
  outputTokens Int      @map("output_tokens")
  cachedTokens Int      @default(0) @map("cached_tokens")
  costMicros   BigInt   @map("cost_micros")
  currency     String   @default("USD") @db.VarChar(3)
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  client Client @relation(fields: [clientId, agencyId], references: [id, agencyId], onDelete: Cascade)
  aiJob  AiJob  @relation(fields: [aiJobId, clientId], references: [id, clientId], onDelete: Cascade)

  @@index([agencyId, occurredAt])
  @@index([clientId, occurredAt])
  @@index([aiJobId])
  @@map("ai_usage_records")
}
